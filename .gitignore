# Publish only reviewed source, synthetic tests and these named assets.
*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/README.txt
!/.github/
!/.github/workflows/
!/.github/workflows/release.yml
!/.github/workflows/ci.yml
!/src/
!/src/*.rs
!/src/bin/
!/src/bin/*.rs
!/ui/
!/ui/*.rhai
!/assets/
!/assets/status-template.svg
!/assets/status-template.pdf
!/tools/
!/tools/generate_icon.py
!/tools/build-release.sh
!/tools/prepare-release.py
!/tests/
!/tests/*.py
